  "Z", ",", "T", ",", "\[Omega]", ",", "XT", ",", " ", "RT", ",", " ", "XE", ",",
    " ", "RE"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ZT", "  ", "=", " ", 
   RowBox[{"Par", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "*", "XT"}], ",", " ", "RT"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ZE", " ", "=", " ", 
   RowBox[{"Par", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "*", "XE"}], ",", " ", "RE"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Z", " ", "=", " ", 
