Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"uRipple", "[", 
   RowBox[{"ub_", ",", " ", "ton_", ",", "toff_", ",", " ", "\[Tau]_"}], 
   "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eon", ",", " ", "eoff", ",", " ", "num", ",", " ", "den"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"eon", " ", "=", " ", 
      RowBox[{"ton", "/", "\[Tau]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eoff", " ", "=", " ", 
      RowBox[{"toff", " ", "/", " ", "\[Tau]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"num", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Exp", "[", "eoff", "]"}], "-", "1"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "eon"}], "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"den", " ", "=", " ", 
      RowBox[{
       RowBox[{"Exp", "[", "eoff", "]"}], "-", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", "eon"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ub", "*", 
      RowBox[{"num", "/", "den"}]}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trefl", " ", "=", " ", 
   RowBox[{"600", "*", 
    RowBox[{"10", "^", 
     RowBox[{"(", 
      RowBox[{"-", "3"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ton", " ", "=", " ", 
   RowBox[{"10", "*", 
    RowBox[{"10", "^", 
     RowBox[{"(", 
      RowBox[{"-", "3"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"toff", " ", "=", " ", 
   RowBox[{"trefl", " ", "-", " ", "ton"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"NSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"uRipple", "[", 
     RowBox[{"5", ",", "ton", ",", " ", "toff", ",", "\[Tau]"}], "]"}], "==", 
    "0.2"}], ",", "\[Tau]"}], "]"}]}], "Input",
